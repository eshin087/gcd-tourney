node_modules
# PR worktrees made by `npm run pr -- start` (ADR 0013); never `git clean -x` the main folder, it would delete them
.worktrees/
# relay state (tools/relay.mjs, ADR 0033): lanes, doorbells, round-trip counts; machine-local, never committed
.relay/
# the publish cache (tools/publish.mjs): a bare repository that npm run publish:github / npm run pr rewrite in; safe to delete
.publish-cache/
dist
tools/.test-fixtures/
# official anime/manga pictures collected for comparison: copyrighted, local only
art/**/reference/source/
# Vercel CLI link + prebuilt output (deploys: npm run deploy)
.vercel

.vercel
.env*
# generated before every build (tools/art-index.mjs)
public/art-index.json
# unapproved world art (vfx, crowd, stage, npc, ui) packed for local review with --candidates; seen with ?art=custom
public/preview/

# the lobby server's local state (wrangler dev, server/)
.wrangler/
