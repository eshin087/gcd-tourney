{
  "name": "gcd-tourney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/lint-anims.mjs && node tools/check-undeclared.mjs && node tools/lint-sim-math.mjs && node tools/art-index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "dev:alt": "vite --port 5200",
    "dev:capped": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/capped.ps1 node node_modules/vite/bin/vite.js",
    "devs": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev-servers.ps1",
    "sprites": "node tools/pack-sprites.mjs",
    "review:export": "node tools/export-art-review.mjs",
    "test:sprites": "node tools/test-pack-sprites.mjs",
    "test:music": "node tools/test-music.mjs",
    "queue": "node tools/queue.mjs",
    "status": "node tools/status.mjs",
    "lineup": "node tools/lineup.mjs",
    "scale": "node tools/scale-audit.mjs",
    "body": "node tools/body-sheet.mjs",
    "stitch": "node tools/stitch-parts.mjs",
    "publish:github": "node tools/publish.mjs",
    "pr": "node tools/pr.mjs",
    "deploy": "node tools/deploy.mjs",
    "lint:anims": "node tools/lint-anims.mjs",
    "lint:undeclared": "node tools/check-undeclared.mjs",
    "lint:simmath": "node tools/lint-sim-math.mjs",
    "test:anims": "node tools/test-tech-anims.mjs",
    "test:alts": "node tools/test-anim-alts.mjs",
    "test:guard": "node tools/test-pr-guard.mjs && node tools/test-sparse-art.mjs && node tools/test-deploy-export.mjs",
    "test:lints": "node tools/test-lints.mjs",
    "relay": "node tools/relay.mjs",
    "test:relay": "node tools/test-relay.mjs",
    "lobby": "npm --prefix server run dev",
    "test:lobby": "node server/test/room.test.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "vite": "^6.0.0"
  }
}
